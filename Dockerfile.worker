# StayOS Worker - Dockerfile
# Node.js Worker stateful

FROM node:20-alpine AS base

# Configurar ambiente
ENV NODE_ENV=production

# Criar usuário não-root
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nextjs -u 1001

# Instalar dependências
WORKDIR /app

# Copiar arquivos de dependências
COPY package.json pnpm-workspace.yaml ./
COPY packages/db/package.json packages/db/
COPY packages/ai/package.json packages/ai/
COPY packages/payments/package.json packages/payments/
COPY apps/worker/package.json apps/worker/

# Instalar pnpm
RUN npm install -g pnpm@8.15.0

# Instalar dependências
RUN pnpm install --frozen-lockfile --filter @stayos/worker

# Copiar código fonte
COPY . .

# Build da aplicação
RUN pnpm --filter @stayos/worker build

# Stage de produção
FROM node:20-alpine AS runner

# Criar usuário não-root
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nextjs -u 1001

WORKDIR /app

# Copiar arquivos do build
COPY --from=base --chown=nextjs:nodejs /app/apps/worker/dist ./dist
COPY --from=base --chown=nextjs:nodejs /app/packages/db/dist ./packages/db/dist
COPY --from=base --chown=nextjs:nodejs /app/packages/ai/dist ./packages/ai/dist
COPY --from=base --chown=nextjs:nodejs /app/packages/payments/dist ./packages/payments/dist

# Usar usuário não-root
USER nextjs

# Expor porta
EXPOSE 4000

# Comando de inicialização
CMD ["node", "dist/index.js"]
