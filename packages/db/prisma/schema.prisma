  // Operação
  operation   String    // sync, push, pull
  
  // Status
  status      String    // success, failed, partial
  
  // Detalhes
  details     Json?
  
  // Metadados
  metadata    Json?
  
  // RLS Policy: tenant_id = tenantId
  @@index([tenantId, channelId, createdAt])
  @@map("ical_sync_logs")
}

