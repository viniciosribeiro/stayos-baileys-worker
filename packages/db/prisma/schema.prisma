// StayOS - Multi-tenant Hotelaria SaaS Platform
// Schema Prisma com isolamento RLS nativo por tenant_id

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS GLOBAIS
// ============================================================================

enum UserRole {
  MASTER_ADMIN
  TENANT_ADMIN
  TENANT_RECEPTIONIST
  TENANT_MANAGER
  TENANT_STAFF
}

enum TenantStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum SubscriptionStatus {
  INACTIVE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

enum PaymentProvider {
  STRIPE
  MERCADO_PAGO
  ASAAS
}

enum PaymentMethodType {
  CARD
  PIX
  BOLETO
  TRANSFER
}

enum TokenProvider {
  OPENAI
  ANTHROPIC
  ELEVENLABS
  WHISPER
  GOOGLE
  AZURE
  OLLAMA
  OPENROUTER
}

enum AIModel {
  GPT4
  GPT4O
  GPT35
  CLAUDE3
  CLAUDE2
  ELEVENLABS_V2
  WHISPER1
}

enum ChannelType {
  WHATSAPP_OFFICIAL
  WHATSAPP_UNOFFICIAL
  INSTAGRAM
  FACEBOOK
  TELEGRAM
  SMS
  EMAIL
  WEBCHAT
  PHONE
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  BLOCKED
}

enum RateType {
  PER_NIGHT
  PER_PERSON
  PER_ROOM
  PACKAGE
}

enum AgePricingModel {
  FREE
  PERCENTAGE_OF_ADULT
  FIXED_PER_NIGHT
  SAME_AS_ADULT
}

enum TourHierarchyLevel {
  WELCOME
  MODULE
  SUBMODULE
  FUNCTION
  MICROHELP
}

enum TourStatus {
  DRAFT
  PUBLISHED
  DEPRECATED
  OUTDATED
}

enum TrainingProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum AuditAction {
  LOGIN
  LOGOUT
  AUTH_FAILURE
  PERMISSION_CHANGE
  REFUND_ISSUED
  SUBSCRIPTION_STATUS_CHANGE
  GUEST_DATA_ACCESS
  API_KEY_CHANGE
  TENANT_SUSPENSION
  TENANT_REACTIVATION
  DATA_EXPORT
  DATA_ANONYMIZATION
  PAYMENT_PROCESSED
  WEBHOOK_RECEIVED
}

enum FiscalDocumentType {
  NFS_E
  NF_E
  RECEIPT
}

enum DunningAttemptStatus {
  PENDING
  SENT
  FAILED
  BOUNCED
}

enum ComissionTierType {
  PERCENTAGE
  FIXED
}

// ============================================================================
// TABELAS DE CONFIGURAÇÃO GLOBAL (MASTER)
// ============================================================================

// Configurações de UI do Painel Master (Módulo 0)
model MasterUISettings {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Identidade
  systemName  String    @default("StayOS")
  logoUrl     String?
  logoCompactUrl String?
  faviconUrl  String?
  
  // Paleta de Cores (HSL base para cálculo automático de variantes)
  colorConfig  Json     // { primary: { h: 210, s: 100, l: 50 }, secondary: {...}, etc. }
  
  // Tipografia
  fontHeadings String   @default("Inter")
  fontBody     String   @default("Inter")
  
  // Bordas e Raios
  borderRadius  Int      @default(8)
  
  // Comportamento de Telas
  defaultModuleOpenMode String @default("FULL_PAGE") // FULL_PAGE, MODAL_CENTER, DRAWER_RIGHT, DRAWER_LEFT, SPLIT_PANEL
  interfaceDensity String @default("COMFORTABLE") // COMPACT, COMFORTABLE, SPACIOUS
  themeMode      String @default("DARK") // DARK, LIGHT, AUTO
  animationsEnabled Boolean @default(true)
  sidebarInitialState String @default("EXPANDED") // EXPANDED, COLLAPSED
  sidebarHoverBehavior String @default("EXPAND") // EXPAND, NONE
  
  // Layout do Dashboard
  dashboardLayout Json? // react-grid-layout config
}

// Configurações de Design System (Módulo 5)
model DesignSystemTheme {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  name        String    @unique
  description String?
  
  // Paleta
  colors      Json     // { primary: "#3b82f6", secondary: "#10b981", etc. }
  
  // Tipografia
  fontFamily  Json     // { headings: "Inter", body: "Inter" }
  fontSizes   Json     // { xs: "0.75rem", sm: "0.875rem", ... }
  
  // Espaçamento e Bordas
  spacing     Json     // { xs: "0.25rem", sm: "0.5rem", ... }
  borderRadius Json    // { sm: "0.25rem", md: "0.5rem", lg: "1rem" }
  
  // Distribuição por Plano
  allowedPlans String[] @default(["Starter", "Pro", "Enterprise"])
  
  // Controle de Override
  allowTenantOverride Boolean @default(true)
}

// ============================================================================
// TABELAS DE TENANTS E USUÁRIOS
// ============================================================================

model Tenant {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Identificação
  name        String
  slug        String    @unique
  domain      String?   @unique
  
  // Status (derivado do Módulo 1.B, nunca setado manualmente)
  status      TenantStatus @default(TRIAL)
  
  // Plano
  planId      String
  plan        PlatformPlan @relation(fields: [planId], references: [id])
  
  // Configurações de UI (override do Master)
  uiConfig    Json?    // { theme: "DARK", colors: {...}, etc. }
  
  // Configurações de Design System
  themeId     String?
  theme       DesignSystemTheme? @relation(fields: [themeId], references: [id])
  
  // Onboarding
  onboardingCompleted Boolean @default(false)
  onboardingProgress  Json?    // Checklist de setup
  
  // Conta Conectada (Módulo 1.B)
  connectedAccountId String?
  connectedAccount ConnectedAccount? @relation(fields: [connectedAccountId], references: [id])
  
  // Metadados
  metadata    Json?
  
  // RLS Policy: tenant_id = id
  @@map("tenants")
}

model User {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Autenticação
  email       String    @unique
  passwordHash String
  
  // Informações Pessoais
  firstName   String?
  lastName    String?
  phone       String?
  avatarUrl   String?
  
  // Papel e Tenant
  role        UserRole
  tenantId    String?
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
  
  // 2FA (Módulo 6)
  totpSecret  String?
  totpEnabled Boolean @default(false)
  
  // Status
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  
  // Preferências
  preferences Json?     // { language: "pt-BR", timezone: "America/Sao_Paulo" }
  
  // RLS Policy: tenant_id = tenantId OR role = MASTER_ADMIN
  @@unique([email, tenantId])
  @@map("users")
}

// Sessões de Autenticação
model Session {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  token       String    @unique
  ipAddress   String?
  userAgent   String?
  
  @@map("sessions")
}

// ============================================================================
// MÓDULO 1.B - SAAS BILLING ENGINE & REVENUE OPERATIONS
// ============================================================================

// Planos da Plataforma
model PlatformPlan {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Identificação
  name        String    @unique
  description String?
  
  // Preços
  basePrice   Int       // Mensalidade fixa em centavos
  annualPrice Int?      // Preço anual (opcional)
  
  // Cota de Tokens (Módulo 2)
  tokenQuota  Int       // Tokens incluídos por mês
  tokenMarkup Int       // Markup percentual para excedentes
  
  // Comissão Transacional (escalonada)
  commissionTiers Json  // [{ tier: 1, minAmount: 0, maxAmount: 2000000, percentage: 3.5 }, ...]
  
  // Canais Omnichannel
  channelQuota Int      // Número de canais incluídos
  
  // Feature Flags
  featureFlags Json     // { voiceCloning: false, byok: false, advancedAnalytics: true, ... }
  
  // Status
  isActive    Boolean   @default(true)
  isPublic    Boolean   @default(true)
  
  // Ordenação
  sortOrder   Int       @default(0)
  
  @@map("platform_plans")
}

// Assinaturas dos Tenants
model PlatformSubscription {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Relacionamentos
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  
  planId      String
  plan        PlatformPlan @relation(fields: [planId], references: [id])
  
  // Status (Máquina de Estados)
  status      SubscriptionStatus @default(INACTIVE)
  
  // Ciclo
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  
  // Trial
  trialStart  DateTime?
  trialEnd    DateTime?
  
  // IDs Externos (Gateways)
  stripeSubscriptionId String?
  mercadoPagoSubscriptionId String?
  asaasSubscriptionId String?
  
  // Método de Pagamento
  defaultPaymentMethodId String?
  
  // Cancelamento
  cancelAtPeriodEnd Boolean @default(false)
  canceledAt        DateTime?
  cancellationReason String?
  
  // Metadados
  metadata    Json?
  
  // RLS Policy: tenant_id = tenantId OR role = MASTER_ADMIN
  @@unique([tenantId])
  @@map("platform_subscriptions")
}

// Métodos de Pagamento (apenas tokens, nunca PAN)
model PlatformPaymentMethod {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Relacionamentos
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  
  subscriptionId String?
  subscription PlatformSubscription? @relation(fields: [subscriptionId], references: [id])
  
  // Provider
  provider    PaymentProvider
  
  // Dados do Cartão (tokenizado)
  paymentMethodId String // ID do método no gateway
  cardBrand     String?
  cardLast4     String?
  cardExpMonth  Int?
  cardExpYear   Int?
  
  // Status
  isDefault    Boolean   @default(false)
  isActive     Boolean   @default(true)
  
  // RLS Policy: tenant_id = tenantId OR role = MASTER_ADMIN
  @@map("platform_payment_methods")
}

// Contas Conectadas (KYC - Módulo 1.B)
model ConnectedAccount {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Relacionamentos
  tenantId    String    @unique
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  
  // Provider
  provider    PaymentProvider
  
  // IDs Externos
  stripeAccountId String?
  mercadoPagoUserId String?
  asaasAccountId String?
  
  // Status de KYC
  kycStatus   String    // pending, verified, rejected
  kycDetails  Json?     // Detalhes do KYC
  
  // Dados Bancários (para repasse)
  bankAccount Json?     // { bank: "Itaú", agency: "1234", account: "56789", cpfCnpj: "..." }
  
  // Status
  isActive    Boolean   @default(false)
  
  // RLS Policy: tenant_id = tenantId OR role = MASTER_ADMIN
  @@map("connected_accounts")
}

// Faturas da Plataforma
model PlatformInvoice {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Relacionamentos
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  
  subscriptionId String
  subscription PlatformSubscription @relation(fields: [subscriptionId], references: [id])
  
  // Período
  periodStart  DateTime
  periodEnd    DateTime
  
  // Valores (em centavos)
  subtotal    Int       // Mensalidade + excedentes
  taxAmount   Int       @default(0)
  totalAmount Int
  
  // Itens da Fatura
  items       PlatformInvoiceItem[]
  
  // Status
  status      String    // draft, open, paid, void, uncollectible
  
  // Pagamento
  paidAt      DateTime?
  paymentMethodId String?
  
  // Documento Fiscal
  fiscalDocumentId String?
  fiscalDocument FiscalDocument? @relation(fields: [fiscalDocumentId], references: [id])
  
  // Metadados
  metadata    Json?
  
  // RLS Policy: tenant_id = tenantId OR role = MASTER_ADMIN
  @@map("platform_invoices")
}

// Itens de Fatura
model PlatformInvoiceItem {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  
  // Relacionamentos
  invoiceId   String
  invoice     PlatformInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  
  // Tipo
  type        String    // subscription, token_usage, commission, addon, adjustment
  
  // Descrição
  description String
  
  // Valores (em centavos)
  amount      Int
  quantity    Int       @default(1)
  
  // Referência
  referenceId String?   // ID do recurso (ex: token_usage_id, reservation_id)
  
  // Metadados
  metadata    Json?
  
  @@map("platform_invoice_items")
}

// Eventos de Billing (Webhooks)
model PlatformBillingEvent {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  
  // Relacionamentos
  tenantId    String?
  subscriptionId String?
  invoiceId   String?
  
  // Evento
  eventType   String    // payment_intent.succeeded, invoice.paid, subscription.created, etc.
  provider    PaymentProvider
  
  // Dados do Evento
  payload     Json
  
  // Idempotência
  idempotencyKey String @unique
  
  // Status
  processed   Boolean   @default(false)
  processedAt DateTime?
  
  // Erros
  errorMessage String?
  
  // RLS Policy: tenant_id = tenantId OR role = MASTER_ADMIN
  @@map("platform_billing_events")
}

// Ledger Financeiro Consolidado do Master
model MasterFinancialLedger {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  
  // Tipo de Lançamento
  entryType   String    // revenue_subscription, revenue_commission, cost_ai, refund, adjustment
  
  // Relacionamentos
  tenantId    String?
  invoiceId   String?
  
  // Valores (em centavos)
  amount      Int
  
  // Categorização
  category    String    // saas_subscription, ai_tokens, commission, fiscal_fee, etc.
  
  // Provider
  provider    String?   // stripe, mercado_pago, asaas, openai, anthropic, elevenlabs
  
  // Período
  period      DateTime  // Data de competência
  
  // Status
  status      String    // pending, confirmed, reconciled
  
  // Reconciliação
  reconciledAt DateTime?
  reconciliationNote String?
  
  // Metadados
  metadata    Json?
  
  @@index([period, entryType])
  @@index([tenantId, period])
  @@map("master_financial_ledger")
}

// Tentativas de Dunning
model DunningAttempt {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  
  // Relacionamentos
  subscriptionId String
  subscription PlatformSubscription @relation(fields: [subscriptionId], references: [id])
  
  invoiceId   String?
  
  // Tentativa
  attemptNumber Int
  
  // Status
  status      DunningAttemptStatus
  
  // Canal
  channel     String    // email, sms, whatsapp
  
  // Resposta
  response    Json?     // Dados da resposta (ex: email entregue, SMS lido)
  
  // Próxima Tentativa
  nextAttemptAt DateTime?
  
  // RLS Policy: tenant_id = subscription.tenantId OR role = MASTER_ADMIN
  @@map("dunning_attempts")
}

// Comissão por Reserva (Módulo 14 ↔ Módulo 1.B)
model CommissionLedger {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  
  // Relacionamentos
  reservationId String
  tenantId      String
  
  // Valores (em centavos)
  grossAmount  Int       // Valor bruto da reserva
  commissionAmount Int   // Comissão retida
  netAmount    Int       // Valor líquido repassado
  
  // Status
  status      String    // pending, rolling_reserve, liquidated, refunded
  
  // Rolling Reserve
  rollingReserveAmount Int @default(0)
  rollingReserveReleasedAt DateTime?
  
  // Pagamento
  paidAt      DateTime?
  paymentMethod String? // split, direct_transfer
  
  // Metadados
  metadata    Json?
  
  // RLS Policy: tenant_id = tenantId OR role = MASTER_ADMIN
  @@map("commission_ledger")
}

// Documentos Fiscais
model FiscalDocument {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  
  // Tipo
  type        FiscalDocumentType
  
  // Relacionamentos
  tenantId    String?
  invoiceId   String?
  
  // Dados do Documento
  documentNumber String?
  documentDate DateTime?
  
  // Valores
  amount      Int
  
  // Provider
  provider    String    // asaas, focus_nfe, nfe_io
  
  // Arquivo
  fileUrl     String?
  
  // Status
  status      String    // pending, issued, cancelled
  
  // Metadados
  metadata    Json?
  
  // RLS Policy: tenant_id = tenantId OR role = MASTER_ADMIN
  @@map("fiscal_documents")
}

// ============================================================================
// MÓDULO 2 - GESTÃO E REVENDA DE IA
// ============================================================================

// Uso de Tokens por Tenant
model AITokenUsage {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  
  // Relacionamentos
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  
  // Provider e Modelo
  provider    TokenProvider
  model       AIModel
  
  // Uso
  tokensUsed  Int
  
  // Tipo de Uso
  usageType   String    // chat, voice, rag, training, etc.
  
  // Referência
  referenceId String?   // ID do recurso (ex: message_id, training_id)
  
  // Custo (em centavos)
  costAmount  Int?
  
  // Metadados
  metadata    Json?
  
  // RLS Policy: tenant_id = tenantId OR role = MASTER_ADMIN
  @@index([tenantId, createdAt])
  @@index([provider, createdAt])
  @@map("ai_token_usage")
}

// Planos de Tokens (Markup)
model AITokenPlan {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Provider
  provider    TokenProvider @unique
  
  // Preços (por 1K tokens)
  pricePer1KTokens Int // Preço de custo em centavos
  markupPercentage Int // Markup percentual para revenda
  
  // Status
  isActive    Boolean   @default(true)
  
  @@map("ai_token_plans")
}

// Orquestrador de Modelos (A/B Testing)
model AIModelRouter {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Regra
  ruleName    String    @unique
  
  // Condições
  conditions  Json      // { tenantId: [...], usageType: [...], plan: [...] }
  
  // Roteamento
  routing     Json      // { primary: { provider: "openai", model: "gpt4" }, fallback: [...] }
  
  // Status
  isActive    Boolean   @default(true)
  
  // Versão
  version     Int       @default(1)
  
  @@map("ai_model_router")
}

// ============================================================================
// MÓDULO 3 - CONFIGURAÇÕES GLOBAIS & COFRE DE CHAVES
// ============================================================================

// Chaves de API Centralizadas (AES-256)
model APIKey {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Provider
  provider    String    @unique // openai, anthropic, elevenlabs, whisper, stripe, mercado_pago, asaas, etc.
  
  // Chave (criptografada)
  encryptedKey String
  
  // Metadados
  description String?
  
  // Status
  isActive    Boolean   @default(true)
  
  // Uso
  lastUsedAt  DateTime?
  usageCount  Int       @default(0)
  
  @@map("api_keys")
}

// Configurações de Gateway de LLM
model LLMGatewayConfig {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Provider
  provider    TokenProvider @unique
  
  // Configuração
  config      Json      // { baseUrl: "...", apiVersion: "...", timeout: 30000, ... }
  
  // Fallback
  fallbackOrder Int[]   // Ordem de fallback
  
  // Status
  isActive    Boolean   @default(true)
  
  // Health Check
  lastHealthCheckAt DateTime?
  healthStatus String?  // healthy, degraded, unavailable
  
  @@map("llm_gateway_config")
}

// ============================================================================
// MÓDULO 4 - WHITE-LABEL & LANDING PAGE
// ============================================================================

// Bloco de Conteúdo da Landing Page
model LandingPageBlock {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Tipo
  blockType   String    // hero, features, pricing, testimonials, cta, etc.
  
  // Conteúdo
  content     Json      // Estrutura do bloco
  
  // Ordenação
  sortOrder   Int
  
  // Status
  isActive    Boolean   @default(true)
  
  // Variantes (A/B Testing)
  variant     String?   @default("A")
  
  @@index([blockType, sortOrder])
  @@map("landing_page_blocks")
}

// Testes A/B
model ABTest {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Identificação
  name        String    @unique
  
  // Configuração
  testType    String    // landing_page, pricing, cta, etc.
  variants    Json      // { A: { blockId: "..." }, B: { blockId: "..." } }
  
  // Métricas
  metrics     Json?     // { impressions: { A: 100, B: 100 }, conversions: { A: 5, B: 8 } }
  
  // Status
  status      String    // draft, running, completed
  
  // Período
  startAt     DateTime?
  endAt       DateTime?
  
  // Vencedor
  winner      String?
  
  @@map("ab_tests")
}

// ============================================================================
// MÓDULO 6 - AUDITORIA, SEGURANÇA E CONFORMIDADE
// ============================================================================

// Logs de Auditoria (Imutáveis)
model AuditLog {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  
  // Usuário
  userId      String?
  userEmail   String?
  
  // Tenant
  tenantId    String?
  
  // Ação
  action      AuditAction
  
  // Detalhes
  details     Json?
  
  // IP e User Agent
  ipAddress   String?
  userAgent   String?
  
  // Metadados
  metadata    Json?
  
  // Trigger para imutabilidade: sem UPDATE/DELETE
  @@map("audit_logs")
}

// ============================================================================
// DOMÍNIO A: INTELIGÊNCIA E ATENDIMENTO (Módulos 7-10)
// ============================================================================

// Conversas (Unified Inbox - Módulo 7)
model Conversation {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Relacionamentos
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  
  // Canal
  channelId   String
  channel     Channel   @relation(fields: [channelId], references: [id])
  
  // Hóspede
  guestId     String?
  guest       Guest?    @relation(fields: [guestId], references: [id])
  
  // Identificação Externa
  externalId  String?   // ID da conversa no canal (ex: WhatsApp group ID)
  
  // Status
  status      String    // open, closed, archived
  
  // Atribuição
  assignedToId String?
  assignedTo  User?     @relation(fields: [assignedToId], references: [id])
  
  // Metadados
  metadata    Json?     // { language: "pt-BR", tags: [...] }
  
  // Mensagens
  messages    Message[]
  
  // RLS Policy: tenant_id = tenantId
  @@index([tenantId, channelId, externalId])
  @@map("conversations")
}

// Mensagens
model Message {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  
  // Relacionamentos
  conversationId String
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  // Remetente
  senderType  String    // guest, tenant, ai
  senderId    String?
  
  // Conteúdo
  content     String?
  
  // Mídia
  mediaUrl    String?
  mediaType   String?   // image, video, audio, document
  
  // Direção
  direction   MessageDirection
  
  // Status
  status      MessageStatus
  
  // Provider Event ID
  providerEventId String?
  
  // Metadados
  metadata    Json?     // { intent: "booking", sentiment: "positive", ... }
  
  // RLS Policy: tenant_id = conversation.tenantId
  @@index([conversationId, createdAt])
  @@map("messages")
}

// Canais (Módulo 19)
model Channel {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Relacionamentos
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  
  // Tipo
  type        ChannelType
  
  // Configuração
  config      Json      // { webhookUrl: "...", apiKey: "...", ... }
  
  // Status
  isActive    Boolean   @default(false)
  isConnected Boolean   @default(false)
  
  // Metadados
  metadata    Json?
  
  // RLS Policy: tenant_id = tenantId
  @@unique([tenantId, type])
  @@map("channels")
}

// Hóspedes (CRM - Módulo 17)
model Guest {
