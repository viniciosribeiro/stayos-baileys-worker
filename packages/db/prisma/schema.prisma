  // Quartos
  rooms       Room[]
  
  // Tarifário
  ratePlanId  String?
  ratePlan    RatePlan? @relation(fields: [ratePlanId], references: [id])
  
  // RLS Policy: tenant_id = tenantId
  @@map("room_groups")
}

// Quartos
model Room {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Relacionamentos
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  
  roomGroupId String?
  roomGroup   RoomGroup? @relation(fields: [roomGroupId], references: [id])
  
  // Identificação
  name        String
  description String?
  
