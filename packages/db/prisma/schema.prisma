  thumbnailUrl String?
  
  // Ordenação
  sortOrder   Int       @default(0)
  
  // Metadados
  metadata    Json?     // { width: 1920, height: 1080, size: 1024, ... }
  
  // RLS Policy: tenant_id = room.tenantId
  @@map("room_photos")
}

// Planos Tarifários (Módulo 11)
model RatePlan {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Relacionamentos
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  
  // Identificação
  name        String
  description String?
  
  // Tipo
  rateType    RateType @default(PER_NIGHT)
  
  // Preço Base (em centavos)
  basePrice   Int
  
  // Preços por Ocupação
  occupancyPricing Json? // { adult: 10000, child: 5000, ... }
  
  // Preços por Faixa Etária (Módulo 11)
  agePricing  Json?     // [{ minAge: 0, maxAge: 2, model: "FREE" }, ...]
  
  // Mínimo de Noites
  minNights   Int       @default(1)
  
  // Status
  isActive    Boolean   @default(true)
  
  // Hierarquia
  priority    Int       @default(0) // Pacotes Fechados > Sazonalidade > Tarifa Base
  
  // Metadados
  metadata    Json?
  
  // RLS Policy: tenant_id = tenantId
  @@map("rate_plans")
}

// Regras de Sazonalidade (Módulo 11)
model SeasonalRule {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Relacionamentos
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  
  // Identificação
  name        String
  
  // Período
  startDate   DateTime
  endDate     DateTime
  
  // Ajuste de Preço
  priceAdjustmentType String // percentage, fixed
  priceAdjustmentValue Int  // +10% ou +R$50,00
  
  // Aplicação
  appliesTo   String[]  // ["all", "room_group_1", "room_1", ...]
  
  // Status
  isActive    Boolean   @default(true)
  
  // Prioridade (Hierarquia: Pacote Fechado > Sazonalidade > Tarifa Base)
  priority    Int       @default(10)
  
  // RLS Policy: tenant_id = tenantId
  @@index([tenantId, startDate, endDate])
  @@map("seasonal_rules")
}

// Pacotes Fechados (Módulo 11)
model Package {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Relacionamentos
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  
  // Identificação
  name        String
  description String?
  
  // Período
  startDate   DateTime
  endDate     DateTime
  
  // Preço (em centavos)
  totalPrice  Int
  
  // Itens do Pacote
  items       Json      // [{ roomGroupId: "...", quantity: 2, nights: 3 }, ...]
  
  // Disponibilidade
  maxBookings Int?
  bookedCount Int       @default(0)
  
  // Status
  isActive    Boolean   @default(true)
  
  // Prioridade (Máxima - Pacotes Fechados > Sazonalidade > Tarifa Base)
  priority    Int       @default(100)
  
  // RLS Policy: tenant_id = tenantId
  @@map("packages")
}

// Calendário de Disponibilidade (Módulo 12)
model CalendarAvailability {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Relacionamentos
  roomId      String
  room        Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  
  // Data
  date        DateTime  @db.Date
  
  // Status
  status      RoomStatus
  
  // Preço (calculado dinamicamente)
  price       Int?
  
  // Bloqueio
  blockedById String?
  
  // Metadados
  metadata    Json?
  
  // RLS Policy: tenant_id = room.tenantId
  @@unique([roomId, date])
  @@index([roomId, date])
  @@map("calendar_availability")
}

// Bloqueios de Quartos (Módulo 12)
model RoomBlock {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Relacionamentos
  roomId      String
  room        Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  
  // Período
  startDate   DateTime  @db.Date
  endDate     DateTime  @db.Date
  
  // Motivo
  reason      String
  
  // Status
  isActive    Boolean   @default(true)
  
  // Metadados
  metadata    Json?
  
  // RLS Policy: tenant_id = room.tenantId
  @@index([roomId, startDate, endDate])
  @@map("room_blocks")
}

// Reservas (Módulo 12)
model Reservation {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Relacionamentos
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  
  guestId     String?
  guest       Guest?    @relation(fields: [guestId], references: [id])
  
  roomId      String
  room        Room      @relation(fields: [roomId], references: [id])
  
  // Código de Confirmação
  confirmationCode String @unique
  
  // Datas
  checkInDate DateTime  @db.Date
  checkOutDate DateTime @db.Date
  
  // Hóspedes
  adults      Int
  children    Int       @default(0)
  
  // Status
  status      ReservationStatus @default(PENDING)
  
  // Valores (em centavos)
  subtotal    Int
  taxAmount   Int       @default(0)
  totalAmount Int
  
  // Pagamento
  paymentStatus String    // pending, paid, failed, refunded
  paymentMethod String?
  paymentReference String? // ID do pagamento no gateway
  
  // Comissão (Módulo 14 ↔ Módulo 1.B)
  commissionAmount Int @default(0)
  
  // Canal de Origem
  sourceChannel String?
  
  // Metadados
  metadata    Json?
  
  // RLS Policy: tenant_id = tenantId
  @@index([tenantId, checkInDate])
  @@index([confirmationCode])
  @@map("reservations")
}

// Sincronização iCal (Módulo 13)
model ICalSyncLog {
  id          String    @id @default(cuid())
