// ============================================================================
// MÓDULO 21 - COPILOTO DE TREINAMENTO
// ============================================================================

// Trilhas Guiadas
model GuidedTour {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Identificação
  moduleId    String    // ID do módulo (ex: "1", "7", "12", "14", "21")
  submoduleId String?   // ID do submódulo (ex: "14.pix", "12.calendar")
  functionId  String?   // ID da função (ex: "14.create_pix", "12.block_room")
  
  // Hierarquia
  hierarchyLevel TourHierarchyLevel
  
  // Alvo
  targetRole  UserRole[] // Para quais papéis esta trilha é relevante
  
  // Conteúdo
  title       String
  description String?
  
  // Passos
  steps       Json      // [{ selector: "#button", text: "...", position: "top", requiresAction: false }, ...]
  
  // Status
  status      TourStatus @default(DRAFT)
  
  // Versão
  version     Int       @default(1)
  
  // Metadados
  metadata    Json?
  
  // Progresso
  progress    TourProgress[]
  
  // Interações
  interactions CopilotInteraction[]
  
  @@unique([moduleId, submoduleId, functionId, hierarchyLevel])
  @@index([moduleId, hierarchyLevel])
  @@map("guided_tours")
}

// Progresso do Tour
model TourProgress {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Relacionamentos
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  
  tourId      String
  tour        GuidedTour @relation(fields: [tourId], references: [id])
  
  // Progresso
  currentStep Int       @default(0)
  totalSteps  Int
  
  // Status
  status      TrainingProgressStatus @default(NOT_STARTED)
  
  // Timestamps
  startedAt   DateTime?
  completedAt DateTime?
  abandonedAt DateTime?
  
  // Metadados
  metadata    Json?
  
  @@unique([userId, tourId])
  @@index([userId, status])
  @@map("tour_progress")
}

// Interações do Copiloto (Busca Semântica)
model CopilotInteraction {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  
  // Relacionamentos
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  
  tourId      String?
  tour        GuidedTour? @relation(fields: [tourId], references: [id])
  
  // Busca
  query       String
  
  // Resultado
  result      Json?     // { tourId: "...", step: 0, ... }
  
  // Metadados
  metadata    Json?
  
  // RLS Policy: user.tenantId = tenantId OR user.role = MASTER_ADMIN
  @@index([userId, createdAt])
  @@map("copilot_interactions")
}

// Registro de Cobertura de Treinamento
model TourCoverageRegistry {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Módulo
  moduleId    String    @unique
  
  // Cobertura
  coverage    Json      // { welcome: true, module: true, submodule: false, function: true, microhelp: true }
  
  // Status
  status      String    // complete, partial, absent
  
  // Metadados
  metadata    Json?
  
  @@map("tour_coverage_registry")
}

// Checklist de Onboarding (Módulo 21)
model OnboardingChecklist {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Relacionamentos
  tenantId    String    @unique
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  
  // Itens
  items       Json      // [{ task: "...", completed: false, tourId: "..." }, ...]
  
  // Progresso
  completedCount Int @default(0)
  totalCount    Int
  
  // Status
  status      String    // not_started, in_progress, completed
  
  // Metadados
  metadata    Json?
  
  // RLS Policy: tenant_id = tenantId
  @@map("onboarding_checklists")
}

// ============================================================================
// MÓDULO 22 - FINANCEIRO SAAS (TENANT)
// ============================================================================

// Portal de Billing do Tenant (contraparte do Módulo 1.B)
// Usa as mesmas tabelas do Módulo 1.B, mas com views específicas para o Tenant
// As tabelas principais já estão definidas acima (PlatformSubscription, PlatformInvoice, etc.)

// ============================================================================
// TABELAS DE SISTEMA
// ============================================================================

// Configurações do Sistema
model SystemConfig {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Chave
  key         String    @unique
  
  // Valor
  value       Json
  
  // Descrição
  description String?
  
  @@map("system_configs")
}

// Fila de Jobs (BullMQ)
model JobQueue {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  
  // Job
  queueName   String
  jobId       String    @unique
  
  // Dados
  data        Json?
  
  // Status
  status      String    // waiting, active, completed, failed, delayed
  
  // Tentativas
  attempts    Int       @default(0)
  
  // Erros
  errorMessage String?
  
  // Timestamps
  startedAt   DateTime?
  completedAt DateTime?
  
  @@index([queueName, status, createdAt])
  @@map("job_queue")
}

// Cache (Redis)
model CacheEntry {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Chave
  key         String    @unique
  
  // Valor
  value       Json?
  
  // TTL
  expiresAt   DateTime?
  
  @@index([expiresAt])
  @@map("cache_entries")
}
