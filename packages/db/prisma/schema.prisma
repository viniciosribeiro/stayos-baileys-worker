  lastName    String?
  fullName    String?
  
  // Contato
  email       String?
  phone       String?
  
  // Perfil
  avatarUrl   String?
  
  // Dados Demográficos
  dateOfBirth DateTime?
  gender      String?
  
  // Localização
  country     String?
  state       String?
  city        String?
  
  // Canal Preferido
  preferredChannel String?
  
  // Tags (IA - Módulo 17)
  tags        String[]  @default([])
  
  // LTV e Histórico
  lifetimeValue Int @default(0) // em centavos
  totalStays   Int @default(0)
  lastStayAt   DateTime?
  
  // Memória (Módulo 9)
  memory       GuestMemory[]
  
  // Conversas
  conversations Conversation[]
  
  // Reservas
